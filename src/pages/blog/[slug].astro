---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { getUi } from "../../i18n/ui";
import { normalizedSlug } from "../../i18n/utils";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft && data.lang === "es");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const t = getUi(post.data.lang);
const { Content } = await render(post);

const slug = normalizedSlug(post.id);
let counterpartHref: string | null = null;
if (post.data.translationKey) {
  const counterpart = await getCollection(
    "blog",
    ({ data }) => !data.draft && data.translationKey === post.data.translationKey && data.lang === "en"
  ).then((p) => p[0]);
  if (counterpart) {
    counterpartHref = `/en/blog/${normalizedSlug(counterpart.id)}/`;
  }
}

const fmt = post.data.pubDate
  ? post.data.pubDate.toLocaleDateString("es-ES", { day: "2-digit", month: "short", year: "numeric" })
  : "";
---

<BaseLayout
  lang="es"
  title={`${post.data.title} | ${t["site.title"]}`}
  description={post.data.description ?? post.data.title}
  alternates={{ es: `/blog/${slug}/`, en: counterpartHref ?? `/en/blog/${slug}/` }}
>
  <main class="mx-auto flex min-h-screen max-w-4xl flex-col gap-8 px-6 py-24">
    <header class="flex flex-col gap-4">
      <div class="flex items-center justify-between gap-3">
        <a class="text-sm text-[var(--color-accent-secondary)] hover:underline" href="/blog/">
          {t["blog.back"]}
        </a>
        {counterpartHref && (
          <a class="text-sm text-[var(--color-accent-secondary)] hover:underline" href={counterpartHref} hreflang="en">
            🇬🇧 English
          </a>
        )}
      </div>
      <time class="text-xs uppercase tracking-wider text-[var(--color-text-secondary)]">{fmt}</time>
      <h1 class="text-balance text-4xl font-bold tracking-tight">{post.data.title}</h1>
      {post.data.description && <p class="text-[var(--color-text-secondary)]">{post.data.description}</p>}
      {post.data.tags && (
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="rounded-full border border-[var(--color-border)] px-3 py-1 text-xs text-[var(--color-accent-secondary)]">#{tag}</span>
          ))}
        </div>
      )}
    </header>

    <article class="prose-invert max-w-none text-[var(--color-text-primary)] leading-relaxed [&_a]:text-[var(--color-accent-secondary)] [&_h1]:mt-8 [&_h2]:mt-8 [&_h2]:text-2xl [&_h2]:font-semibold [&_h3]:mt-6 [&_h3]:text-xl [&_pre]:rounded-2xl [&_pre]:bg-[var(--color-bg-surface)] [&_code]:text-[var(--color-accent-secondary)]">
      <Content />
    </article>
  </main>
</BaseLayout>
