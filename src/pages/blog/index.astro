---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getUi } from "../../i18n/ui";
import { normalizedSlug } from "../../i18n/utils";

const lang = "es" as const;
const t = getUi(lang);
const posts = (await getCollection("blog", ({ data }) => !data.draft && data.lang === lang)).sort(
  (a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0)
);

const fmt = (d?: Date) =>
  d ? d.toLocaleDateString("es-ES", { day: "2-digit", month: "short", year: "numeric" }) : "";
---

<BaseLayout lang={lang} title={`${t["blog.title"]} | ${t["site.title"]}`} description={t["blog.subtitle"]}>
  <main class="mx-auto flex min-h-screen max-w-6xl flex-col gap-12 px-6 py-24">
    <header class="flex flex-col gap-4">
      <h1 class="text-balance text-4xl font-bold tracking-tight">{t["blog.title"]}</h1>
      <p class="text-[var(--color-text-secondary)]">{t["blog.subtitle"]}</p>
    </header>

    {
      posts.length === 0 ? (
        <div class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-bg-surface)]/40 p-8 text-[var(--color-text-secondary)]">
          {t["blog.empty"]}
        </div>
      ) : (
        <ul class="flex flex-col gap-6">
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${normalizedSlug(post.id)}/`}
                class="glow-border flex flex-col gap-2 rounded-3xl bg-[var(--color-bg-surface)]/60 p-6 transition hover:scale-[1.01]"
              >
                <div class="flex items-center justify-between gap-3">
                  <time class="text-xs uppercase tracking-wider text-[var(--color-text-secondary)]">
                    {fmt(post.data.pubDate)}
                  </time>
                  <span class="text-sm">🇪🇸</span>
                </div>
                <h2 class="text-2xl font-semibold">{post.data.title}</h2>
                {post.data.description && <p class="text-[var(--color-text-secondary)]">{post.data.description}</p>}
                {post.data.tags && (
                  <div class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="rounded-full border border-[var(--color-border)] px-3 py-1 text-xs text-[var(--color-accent-secondary)]">#{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</BaseLayout>
