---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { type Lang, getUi } from "../../i18n/ui";
import { langPrefix } from "../../i18n/utils";

const lang: Lang = "en";
const t = getUi(lang);
const prefix = langPrefix(lang);
---

<BaseLayout lang={lang} title={`${t["site.title"]} · ${t["nav.home"]}`} description={t["home.hero.subtitle"]}>
  <main class="mx-auto flex min-h-screen max-w-7xl flex-col gap-20 px-6 py-24">
    <section class="hero-gradient flex flex-col items-center gap-6 text-center">
      <div class="glow-border rounded-full px-4 py-1 text-sm text-[var(--color-text-secondary)]">
        {t["home.badge"]} · Minimal dark
      </div>
      <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
        {t["site.title"]}
      </h1>
      <p class="max-w-2xl text-balance text-lg text-[var(--color-text-secondary)]">
        {t["home.hero.subtitle"]}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href={`${prefix}/blog/`}
          class="glow-border inline-flex items-center gap-2 rounded-full bg-[var(--color-bg-surface)]/70 px-6 py-2 text-sm font-medium transition hover:scale-[1.01]"
        >
          {t["home.cta.blog"]}
        </a>
      </div>
    </section>

    <section id="about" class="flex flex-col gap-6">
      <h2 class="text-3xl font-semibold">{t["home.about.title"]}</h2>
      <p class="max-w-4xl text-[var(--color-text-secondary)] leading-relaxed">
        {t["home.about.body"]} <a class="text-[var(--color-accent-secondary)] hover:underline" href={`${prefix}/blog/about-me/`}>{t["home.about.link"]}</a>.
      </p>
    </section>

    <section class="flex flex-col gap-6">
      <h3 class="text-3xl font-semibold">{t["home.stack.title"]}</h3>
      <div class="flex flex-wrap gap-3 text-sm">
        {t["home.stack.items"].map((tech) => (
          <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-bg-surface)]/60 px-4 py-1">{tech}</span>
        ))}
      </div>
    </section>

    <section class="flex flex-col gap-6 text-center">
      <h3 class="text-3xl font-semibold">{t["home.contact.title"]}</h3>
      <p class="mx-auto max-w-2xl text-balance text-[var(--color-text-secondary)]">
        {t["home.contact.body"]}
      </p>
    </section>
  </main>
</BaseLayout>
