---
import LangSwitcher from "./LangSwitcher.astro";
import type { Lang } from "../i18n/ui";
import { getUi } from "../i18n/ui";

interface Props {
  lang: Lang;
  hrefEspanol: string;
  hrefIngles: string;
}

const { lang, hrefEspanol, hrefIngles } = Astro.props;
const t = getUi(lang);
const prefix = lang === "es" ? "" : "/en";
---

<header class="sticky top-0 z-10 w-full border-b border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-4">
    <a href={`${prefix}/`} class="text-sm font-semibold tracking-tight">
      {t["site.title"]}
    </a>
    <nav class="flex items-center gap-4 text-sm">
      <a class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]" href={`${prefix}/`}>
        {t["nav.home"]}
      </a>
      <a class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]" href={`${prefix}/blog/`}>
        {t["nav.blog"]}
      </a>
      <LangSwitcher lang={lang} hrefEspanol={hrefEspanol} hrefIngles={hrefIngles} />
    </nav>
  </div>
</header>
